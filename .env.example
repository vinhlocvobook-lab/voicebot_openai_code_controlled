# Giai doan 0 - server cơ bản
PORT=3000
NODE_ENV=development

# Giai doan 1 - can de ket noi truc tiep toi OpenAI Realtime API (script
# scripts/probe-realtime.mjs). Copy file nay thanh .env roi dien key that -
# KHONG commit .env (da co trong .gitignore).
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Giai doan 5 - can de goi that toi API Tong dai CNTA (api.php) qua
# src/integrations/tongdai-api.js. Copy sang .env roi dien gia tri that -
# KHONG commit .env.
TONGDAI_API_BASE=http://127.0.0.1:7700/api.php
TONGDAI_API_KEY=
TONGDAI_API_TIMEOUT_MS=15000
# BAT true CHI khi api.php dang chay HTTPS voi self-signed cert noi bo -
# de false/bo trong khi cert da la CA hop le (production that).
TONGDAI_API_INSECURE_TLS=false

# Giai doan 5 - ghi log cuoc goi/ticket qua REST (voicebot-log-api.php) thay
# vi ket noi MariaDB truc tiep - src/integrations/calllog-api.js. Copy sang
# .env roi dien gia tri that - KHONG commit .env. De trong LOG_API_BASE =>
# bo qua ghi log qua API (bot van chay binh thuong, khong sap).
LOG_API_BASE=
LOG_API_KEY=
LOG_API_TIMEOUT_MS=15000
LOG_API_INSECURE_TLS=false
VOICEBOT_LOG_FOLDER_ON_API_SERVER=

# Giai doan 8 - noi SIP that qua OpenAI Realtime Calls API
# (src/integrations/realtime-calls-api.js, src/webhook-verify.js). Copy
# sang .env roi dien gia tri that - KHONG commit .env.
# OPENAI_PROJECT_ID: dung de dung SIP trunk that (Asterisk) tro toi
# sip:{OPENAI_PROJECT_ID}@sip.api.openai.com - CHI hien thi trong log khoi
# dong (xem server.js khi viet that), khong dung de goi API nao o day.
OPENAI_PROJECT_ID=
# OPENAI_WEBHOOK_SECRET: dang "whsec_<base64>" (Svix) - OpenAI cap khi tao
# webhook endpoint. De trong => webhook-verify.js CHO QUA khong xac minh
# chu ky (CHI dung khi phat trien cuc bo, KHONG duoc de trong o production
# that - xem canh bao console.warn trong src/webhook-verify.js).
OPENAI_WEBHOOK_SECRET=
WEBHOOK_PATH=/webhook
